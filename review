#!/usr/bin/env python3
"""
Log triage report for a WordPress/nginx server (BigScoots WPO layout).

Run from anywhere (e.g. /root):
    python3 log_report.py                 # prompts for the domain
    python3 log_report.py example.com     # domain as an argument
    python3 log_report.py example.com --top 50

Works in /home/nginx/domains/<domain>/log and reports:
  1. Top 404 paths           (access.log, status field == 404)
  2. PHP fatal errors        (/var/log/php-fpm/www-php.error.log)
  3. "access forbidden by rule" paths under /wp-content (error.log)
  4. Redirect rules in ../public/.htaccess (if the file exists)
Then runs /bigscoots/wpo/extras/wpadmin_user.sh from ../public
(this CREATES the 'bigscoots' admin user, pass --no-wpadmin to skip it).
"""
import argparse
import os
import re
import subprocess
import sys
from collections import Counter

BASE = "/home/nginx/domains"
WPADMIN_SCRIPT = "/bigscoots/wpo/extras/wpadmin_user.sh"
PHP_LOG = "/var/log/php-fpm/www-php.error.log"

ACCESS_RE = re.compile(r'"(?:\S+) (?P<path>\S+) [^"]*" (?P<status>\d{3}) ')
FATAL_TS_RE = re.compile(r'^\[[^\]]+\]\s*')
FORBIDDEN_RE = re.compile(r'request: "\S+ (?P<path>/wp-content[^\s"]*)')
HTACCESS_RE = re.compile(
    r'RedirectMatch|Redirect 301|RewriteRule|' + re.escape('([0-9]{4})'), re.I
)
DOMAIN_RE = re.compile(r'^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$')


def clean_domain(raw):
    d = raw.strip().lower()
    d = re.sub(r'^https?://', '', d).split('/')[0]
    return d


def read_lines(path):
    """Yield lines from path, tolerating bad bytes. Yield nothing if unreadable."""
    try:
        with open(path, "r", errors="replace") as fh:
            yield from fh
    except OSError as exc:
        print(f"  ! cannot read {path}: {exc.strerror}", file=sys.stderr)


def print_table(title, headers, rows, note=None):
    print(f"\n== {title} ==")
    if note:
        print(note)
    if not rows:
        print("  (no results)")
        return
    rows = [tuple(str(c) for c in r) for r in rows]
    widths = [max(len(h), *(len(r[i]) for r in rows)) for i, h in enumerate(headers)]
    line = "+-" + "-+-".join("-" * w for w in widths) + "-+"
    print(line)
    print("| " + " | ".join(h.ljust(w) for h, w in zip(headers, widths)) + " |")
    print(line)
    for r in rows:
        print("| " + " | ".join(c.ljust(w) for c, w in zip(r, widths)) + " |")
    print(line)


def top_404(path, top):
    c = Counter()
    for line in read_lines(path):
        m = ACCESS_RE.search(line)
        if m and m.group("status") == "404":
            c[m.group("path")] += 1
    print_table(
        "TOP 404 PATHS",
        ("COUNT", "PATH"),
        c.most_common(top),
        note=f"{sum(c.values())} total 404s, {len(c)} unique paths (showing top {top})",
    )


def php_fatals(path, top):
    c = Counter()
    for line in read_lines(path):
        if "Fatal" in line:
            c[FATAL_TS_RE.sub("", line.strip())] += 1
    print_table("PHP FATAL ERRORS", ("COUNT", "ERROR"), c.most_common(top))


def forbidden(path, top):
    c = Counter()
    for line in read_lines(path):
        if "access forbidden by rule" in line:
            m = FORBIDDEN_RE.search(line)
            if m:
                c[m.group("path")] += 1
    print_table(
        "ACCESS FORBIDDEN BY RULE (/wp-content)",
        ("COUNT", "PATH"),
        c.most_common(top),
    )


def htaccess(path):
    if not os.path.isfile(path):
        print("\n== .HTACCESS REDIRECT RULES ==")
        print(f"  {path} not found (nginx does not use .htaccess)")
        return
    rows = [
        (n, line.strip())
        for n, line in enumerate(read_lines(path), 1)
        if HTACCESS_RE.search(line)
    ]
    print_table(".HTACCESS REDIRECT RULES", ("LINE", "RULE"), rows)


def run_wpadmin(public_dir):
    print("\n== WPADMIN USER (bigscoots) ==")
    if not os.path.isfile(WPADMIN_SCRIPT):
        print(f"  {WPADMIN_SCRIPT} not found")
        return
    try:
        res = subprocess.run(
            ["bash", WPADMIN_SCRIPT],
            cwd=public_dir,
            capture_output=True,
            text=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        print("  ! timed out after 300s")
        return
    out = (res.stdout or "").strip()
    err = (res.stderr or "").strip()
    if out:
        print(out)
    if err:
        print(err, file=sys.stderr)
    if res.returncode != 0:
        print(f"  ! exited with code {res.returncode}")


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    p.add_argument("domain", nargs="?", help="domain name, e.g. example.com")
    p.add_argument("--top", type=int, default=30, help="rows per table (default 30)")
    p.add_argument("--no-wpadmin", action="store_true", help="skip wpadmin_user.sh")
    a = p.parse_args()

    raw = a.domain or input("Domain name (e.g. example.com): ")
    domain = clean_domain(raw)
    if not DOMAIN_RE.match(domain) or ".." in domain:
        sys.exit(f"Invalid domain: {raw!r}")

    log_dir = os.path.join(BASE, domain, "log")
    public_dir = os.path.join(BASE, domain, "public")
    if not os.path.isdir(log_dir):
        sys.exit(f"Log directory not found: {log_dir}")

    os.chdir(log_dir)
    print(f"Domain: {domain}\nLog dir: {log_dir}")

    top_404("access.log", a.top)
    php_fatals(PHP_LOG, a.top)
    forbidden("error.log", a.top)
    htaccess(os.path.join(public_dir, ".htaccess"))

    if a.no_wpadmin:
        print("\n(wpadmin_user.sh skipped)")
    elif not os.path.isdir(public_dir):
        print(f"\n! Public directory not found: {public_dir}, wpadmin skipped")
    else:
        run_wpadmin(public_dir)


if __name__ == "__main__":
    main()
